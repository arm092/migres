mysql:
  host: host.docker.internal
  port: 3306
  user: repluser
  password: password
  database: source_db
  include_tables: [
    "users",
    "orders",
    "transactions",
  ]  # empty = all
  exclude_tables: []
  # Optional TLS:
  # ssl_ca: /path/to/ca.pem
  # ssl_disabled: false

clickhouse:
  host: 127.0.0.1
  port: 9000
  user: chuser
  password: "root"
  database: target_db
  # Optional TLS:
  # secure: true
  # verify: true
  # ca_certs: /path/to/ca.pem

migration:
  # Debug mode (true/false) - enables verbose logging for CDC events
  # Can be overridden with MIGRATION_DEBUG environment variable
  debug: false
  batch_rows: 5000
  ddl_engine: "ReplacingMergeTree"
  low_cardinality_strings: true
  workers: 4   # number of parallel table workers (default 4)
  # Timezone configuration for datetime/timestamp columns
  clickhouse_timezone: "Asia/Yerevan"  # Set to desired ClickHouse timezone
  cdc:
    heartbeat_seconds: 5
    checkpoint_interval_rows: 1000  # Transformer waits until this many raw events (0 = disable waiting)
    prepared_queries_batch_limit: 100
    producer_flush_interval: 5      # Producer: flush binlog batch to buffer.db (seconds)
    transformer_poll_interval: 0.5  # Transformer: poll wait when below checkpoint_interval_rows
    consumer_poll_interval: 0.5     # Consumer: sleep when prepared queue is empty / short batch
    batch_max_wait_seconds: 60
    producer_batch_size: 100  # Number of events producer accumulates before flushing to buffer
    raw_events_max: 50000           # Backpressure: pause producer when raw_events >= this
    raw_events_resume_ratio: 0.8    # Resume when raw_events <= max * ratio
    use_gtid: false                 # When true, position via GTID (auto_position) instead of file:pos
    snapshot_before: true  # Run snapshot before CDC
    server_id: 4379  # Unique ID for binlog replication
    force_binlog_position: null  # Optional: "mysql-bin.000123:6855245" format to force specific binlog position (used by SIGUSR2 handler)
    db_debug: false  # If true, archive processed events/queries to ClickHouse debug tables

# Where migres persists its resumable state
state_file: /app/data/state.json
# SQLite buffer path (must be writable)
buffer_file: /app/data/buffer.db

# Can be overridden with ENVIRONMENT environment variable
# Default: prod
environment: dev

# MS Teams Notifications
notifications:
  enabled: true
  webhook_url: "https://your-org.webhook.office.com/webhookb2/your-webhook-url"
  rate_limit_seconds: 60  # Minimum seconds between notifications (0 = no limit)
  # Rate limiting is per notification type (cdc_error, cdc_warning, cdc_info, etc.)
